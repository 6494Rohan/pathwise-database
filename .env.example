# Local Docker database (docker compose up -d). Compose reads LOCAL_DB_PASSWORD from this file.
LOCAL_DB_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://pathwise:<LOCAL_DB_PASSWORD>@localhost:5432/pathwise

# AWS RDS (dev): build it from the backend repo's Terraform outputs; see README
DATABASE_URL=postgresql+psycopg://pathwise_admin:<password>@<db host>:5432/pathwise?sslmode=require
